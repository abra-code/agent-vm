{
  "version": 1,
  "description": "Homebrew",
  "steps": [
    {
      "name": "Homebrew folder, owned by the box user",
      "user": "root",
      "run": "mkdir -p /opt/homebrew && chown -R \"$AGENT_VM_BOX_USER\":admin /opt/homebrew"
    },
    {
      "name": "The install script",
      "copy": "files/install-homebrew.sh",
      "to": "/private/var/tmp/agent-vm-install-homebrew",
      "mode": "0755"
    },
    {
      "name": "Homebrew as its own installer installs it: a git copy at the newest release",
      "run": "/private/var/tmp/agent-vm-install-homebrew; status=$?; rm -f /private/var/tmp/agent-vm-install-homebrew; exit $status",
      "env": { "HOMEBREW_NO_ANALYTICS": "1" },
      "timeoutSeconds": 1800
    },
    {
      "name": "Homebrew in login shells",
      "copy": "files/zprofile",
      "to": "~/.zprofile"
    }
  ],
  "update": [
    {
      "name": "Homebrew, and everything installed with it",
      "run": "/opt/homebrew/bin/brew update --quiet && /opt/homebrew/bin/brew upgrade && /opt/homebrew/bin/brew cleanup --prune=all -s",
      "env": { "HOMEBREW_NO_ANALYTICS": "1", "HOMEBREW_NO_ENV_HINTS": "1" },
      "timeoutSeconds": 3600
    }
  ],
  "checks": ["brew --version"]
}

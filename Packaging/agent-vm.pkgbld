      "IDENTIFIER" : "com.abracode.pkg.agent-vm",
      "VERSION" : "",
      "DESCRIPTION" : "Installs this version in ~\/.local\/share\/agent-vm\/versions and points ~\/.local\/bin\/agent-vm and ~\/.local\/bin\/avm at it. Earlier versions stay where they are, so boxes they started keep running.",
